# Copy to dot-blog-backend/.env and fill in values. Do not commit .env.
# Services load this file automatically when you run from each module (see README).

# MongoDB (used by all services that have a DB)
DATABASE_URI=mongodb://localhost:27017

# Auth Service - JWT secret (must match existing Node backend if migrating)
JWT_SECRET=Dot-Blog2_SecretKey

# Email (Resend) - for OTP and password reset; from-address must be allowed in Resend
RESEND_API_KEY=
SENDER_MAIL_ID=

# Frontend URL - for password reset link
FRONTEND_URL=http://localhost:3000

# Cloudinary - for thumbnails, profile/cover photos
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Two-way encryption for userId in resend OTP (optional, match Node)
TWO_WAY_SECRET=
